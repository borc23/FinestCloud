# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyc

# Models (large files - download from HuggingFace instead)
models/*.pt
app/models/*.pt
*.pth
*.bin

# Images (if not needed in version control)
*.png
*.jpg
*.jpeg
# ...except figures used by the docs
!docs/images/*.png

# Saved capture images
saved_images/

*.ipynb

# Environment and IDE
.env
.venv
.env.local
.env*.local
env/
venv/
ENV/
.idea/
.vscode/

# Logs and databases
*.log
*.sqlite

sandbox/
.claude
# Tooling / build
*.egg-info
.ruff_cache
.pytest_cache
.tmp
dist
.DS_Store
.ipynb_checkpoints
.coverage

# No sops encryption set up: never commit plaintext secrets
deploy/secrets/*
!deploy/secrets/.gitkeep
