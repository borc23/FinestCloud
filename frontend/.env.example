# Copy this file to .env.local and fill in your actual values

# Google Maps JavaScript API Key (client-side) - Restrict to HTTP referrers
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_maps_javascript_api_key_here

# Google Static Maps API Key (server-side) - Restrict to IP addresses
GOOGLE_MAPS_API_KEY=your_static_maps_api_key_here

# Python FastAPI Backend URL (server-side only, not exposed to client)
PYTHON_BACKEND_URL=http://127.0.0.1:8000