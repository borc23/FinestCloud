# Copy this file to .env.local and fill in your actual values (.env.local is gitignored).
# In production, set these in the Vercel dashboard instead. Never commit real keys.

# Google Maps JavaScript API Key (client-side) - Restrict to HTTP referrers
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_maps_javascript_api_key_here

# Google server key (Solar API) - server-side only
GOOGLE_MAPS_API_KEY=your_server_api_key_here

# Python FastAPI Backend URL (server-side only, not exposed to client)
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Shared secret sent to the backend as X-Backend-Token (server-side only).
# Must match BACKEND_API_TOKEN in the backend env. Generate with: openssl rand -hex 32
BACKEND_API_TOKEN=

NEXT_PUBLIC_SUPABASE_URL=your_public_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_supabase_anon_key_here

# Optional: show a "Try the demo" button that signs visitors in anonymously.
# Requires Authentication > Sign In / Providers > "Allow anonymous sign-ins" in Supabase.
NEXT_PUBLIC_ENABLE_GUEST_DEMO=false
