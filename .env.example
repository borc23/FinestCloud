# Backend environment variables.
# Copy to .env for local development and fill in real values (.env is gitignored).
# In production, set these in the Render dashboard instead. Never commit real keys.

# Required: Google server key (Solar API + Maps Static API)
GOOGLE_MAPS_API_KEY=your_google_server_key

# Required: NREL key for PVWatts (https://developer.nlr.gov/signup/)
NREL_API_KEY=your_nrel_api_key

# Optional: only needed if the Hugging Face model repo is private
HUGGING_FACE_TOKEN=
